#!/usr/bin/env bash

set -euo pipefail

SCRIPT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
WORKTREE_ROOT=$(cd "${T3CODE_WORKTREE_PATH:-$SCRIPT_ROOT}" && pwd -P)
SOURCE_ROOT=${T3CODE_PROJECT_ROOT:-$(git -C "$WORKTREE_ROOT" worktree list --porcelain | sed -n '1s/^worktree //p')}
SOURCE_ROOT=$(cd "$SOURCE_ROOT" && pwd -P)

if [[ "$SOURCE_ROOT" == "$WORKTREE_ROOT" ]]; then
    if [[ ! -f "$WORKTREE_ROOT/.env.local" ]]; then
        printf 'Missing %s/.env.local. Copy .env.example and fill in the Prezly token and newsroom.\n' "$WORKTREE_ROOT" >&2
        exit 1
    fi
    printf 'Using runtime files in %s.\n' "$WORKTREE_ROOT"
    exit 0
fi

if [[ ! -f "$SOURCE_ROOT/.env.local" ]]; then
    printf 'Missing %s/.env.local. Add it and rerun this action.\n' "$SOURCE_ROOT" >&2
    exit 1
fi

install -m 600 "$SOURCE_ROOT/.env.local" "$WORKTREE_ROOT/.env.local"
if [[ -f "$SOURCE_ROOT/.env" ]]; then
    install -m 600 "$SOURCE_ROOT/.env" "$WORKTREE_ROOT/.env"
fi
printf 'Copied runtime files from %s to %s.\n' "$SOURCE_ROOT" "$WORKTREE_ROOT"
